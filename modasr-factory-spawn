#!/bin/sh
set -eu

case "${1:-}" in
  ''|*[!0-9]*)
    echo "invalid_factory_id" >&2
    exit 1
    ;;
esac

id="$1"
root="/var/www/modasr-hosting-tenants/$id"
service="modasr-hosting-tenant-$id.service"
action="${2:-start}"
case "$action" in
  stop)
    systemctl stop "$service"
    printf 'stopped\n'
    exit 0
    ;;
  status)
    systemctl is-active --quiet "$service"
    printf 'active\n'
    exit 0
    ;;
  start)
    ;;
  *)
    echo "invalid_runtime_action" >&2
    exit 1
    ;;
esac

test -f "$root/tenant.json"
test -f "$root/worker.php"
test -f "$root/.env"
php -l "$root/worker.php" >/dev/null
chown root:modasrstaging "$root/.env"
chmod 640 "$root/.env"

cat > "/etc/systemd/system/$service" <<UNIT
[Unit]
Description=MODASR Hosting Tenant $id
After=network.target docker.service modasr-hosting-full-php.service

[Service]
Type=simple
User=modasrstaging
Group=modasrstaging
WorkingDirectory=$root
Environment=TENANT_ROOT=$root
ExecStart=/usr/bin/php $root/worker.php
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$root

[Install]
WantedBy=multi-user.target
UNIT

chmod 644 "/etc/systemd/system/$service"
systemctl daemon-reload
systemctl enable --now "$service"
sleep 1
systemctl is-active --quiet "$service"
printf 'active\n'
